DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Route POST /api/dispatch directly to /api/dispatch/index.php without 301 redirect
  RewriteRule ^api/dispatch/?$ api/dispatch/index.php [L,QSA]

  # Route /api/git-sync directly to /api/git-sync/index.php
  RewriteRule ^api/git-sync/?$ api/git-sync/index.php [L,QSA]

  # Serve directory index.html for clean URLs (e.g. /roboflow -> /roboflow/index.html)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*[^/])$ $1/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/$ $1/index.html [L]

  # Serve standalone .html if exists (e.g. /roboflow.html)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)/?$ $1.html [L]

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA Fallback to index.html
  RewriteRule ^ index.html [L]
</IfModule>
